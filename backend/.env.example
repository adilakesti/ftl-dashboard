# Custom environment variables & secrets for this app.
# Filled in via the portal (or `/substrait:env`) after upload.

# ID of the "FTL Rates" Google Sheet (the long id in its URL between /d/ and /edit).
GOOGLE_SHEET_ID=

# Service account credentials (full JSON key content, one line) used to read the
# sheet read-only. Share the sheet with this service account's email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=   # secret
