# Custom environment variables for this app.
# Filled in via the portal (or `/substrait:env`) after upload.

# ID of the "FTL Rates" Google Sheet (the long id in its URL between /d/ and /edit).
# The sheet must be shared as "Anyone with the link can view" — fetched via Google's
# public CSV export endpoint, no API key or service account needed.
GOOGLE_SHEET_ID=

# gid of the "Database Rate" tab (the number after #gid= in the sheet URL). Defaults
# to 0 (the first tab) if unset.
GOOGLE_SHEET_GID=0
